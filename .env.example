# AIRMAN Aviation RAG System - Environment Configuration Template
# Copy this file to .env and update with your values

# ============================================================================
# Ollama Configuration
# ============================================================================

# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name
OLLAMA_MODEL=llama3.1:8b

# LLM temperature (0.0 = deterministic, 1.0 = creative)
OLLAMA_TEMPERATURE=0.0

# Maximum tokens to generate
OLLAMA_MAX_TOKENS=768

# ============================================================================
# Retrieval Configuration
# ============================================================================

# Number of chunks to retrieve
TOP_K=7

# Vector similarity threshold (0.0-1.0)
SIMILARITY_THRESHOLD=0.30

# Reranker threshold (Level 2)
RERANK_THRESHOLD=-5.0

# ============================================================================
# Faithfulness Configuration
# ============================================================================

# Faithfulness threshold (0.0-1.0)
# Answers below this threshold will be rejected
FAITHFULNESS_THRESHOLD=0.50

# ============================================================================
# Chunking Configuration
# ============================================================================

# Chunk size in words
CHUNK_SIZE=400

# Overlap between chunks in words
CHUNK_OVERLAP=50

# Minimum chunk size in words
MIN_CHUNK_WORDS=30

# ============================================================================
# Embedding Configuration
# ============================================================================

# Embedding model name
EMBEDDING_MODEL=multi-qa-mpnet-base-dot-v1

# Embedding dimension
EMBEDDING_DIM=768

# ============================================================================
# API Configuration
# ============================================================================

# API host
API_HOST=0.0.0.0

# API port
API_PORT=8000

# Enable debug mode (true/false)
DEBUG=false

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=./logs/app.log

# ============================================================================
# Database Configuration (if using)
# ============================================================================

# Database URL (optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/airman

# ============================================================================
# Security (Production)
# ============================================================================

# Secret key for sessions (generate with: openssl rand -hex 32)
# SECRET_KEY=your-secret-key-here

# API key for authentication (optional)
# API_KEY=your-api-key-here

# ============================================================================
# Monitoring (Production)
# ============================================================================

# Enable metrics collection
# ENABLE_METRICS=true

# Metrics port
# METRICS_PORT=9090

# ============================================================================
# Notes
# ============================================================================

# 1. Copy this file to .env: cp .env.example .env
# 2. Update values as needed
# 3. Never commit .env to version control
# 4. Keep .env.example updated with new variables
